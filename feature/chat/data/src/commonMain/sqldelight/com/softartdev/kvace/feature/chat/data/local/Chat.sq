CREATE TABLE chats (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  title_is_manual INTEGER NOT NULL DEFAULT 0,
  created_at_millis INTEGER NOT NULL,
  updated_at_millis INTEGER NOT NULL
);

CREATE INDEX chats_updated_at_millis ON chats(updated_at_millis);

CREATE TABLE chat_messages (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  chat_id INTEGER NOT NULL REFERENCES chats(id) ON DELETE CASCADE,
  author TEXT NOT NULL,
  text TEXT NOT NULL,
  created_at_millis INTEGER NOT NULL,
  generated_by_model_name TEXT,
  generated_at_millis INTEGER,
  error_type TEXT
);

CREATE INDEX chat_messages_chat_created ON chat_messages(chat_id, created_at_millis, id);

selectChatById:
SELECT *
FROM chats
WHERE id = ?;

selectChatSummaries:
SELECT
  chats.id AS id,
  chats.title AS title,
  last_message.text AS lastMessagePreview,
  last_message.error_type AS lastMessageError,
  chats.updated_at_millis AS updatedAtMillis,
  COUNT(chat_messages.id) AS messageCount
FROM chats
LEFT JOIN chat_messages ON chat_messages.chat_id = chats.id
LEFT JOIN chat_messages AS last_message ON last_message.id = (
  SELECT id
  FROM chat_messages
  WHERE chat_id = chats.id
  ORDER BY created_at_millis DESC, id DESC
  LIMIT 1
)
GROUP BY chats.id
ORDER BY chats.updated_at_millis DESC, chats.id DESC;

selectMessagesByChatId:
SELECT *
FROM chat_messages
WHERE chat_id = ?
ORDER BY created_at_millis ASC, id ASC;

insertChat:
INSERT INTO chats(title, title_is_manual, created_at_millis, updated_at_millis)
VALUES (?, ?, ?, ?);

selectLastInsertRowId:
SELECT last_insert_rowid();

insertMessage:
INSERT INTO chat_messages(chat_id, author, text, created_at_millis, generated_by_model_name, generated_at_millis, error_type)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateMessageText:
UPDATE chat_messages
SET text = ?,
    generated_by_model_name = ?,
    generated_at_millis = ?
WHERE id = ? AND chat_id = ?;

deleteMessage:
DELETE FROM chat_messages
WHERE id = ? AND chat_id = ?;

updateChatTitle:
UPDATE chats
SET title = ?,
    title_is_manual = ?,
    updated_at_millis = ?
WHERE id = ?;

autoUpdateChatTitleAfterFirstMessage:
UPDATE chats
SET title = ?,
    updated_at_millis = ?
WHERE id = ?
  AND title_is_manual = 0
  AND (
    SELECT COUNT(*)
    FROM chat_messages
    WHERE chat_id = ?
  ) = 1;

deleteChat:
DELETE FROM chats
WHERE id = ?;

touchChat:
UPDATE chats
SET updated_at_millis = ?
WHERE id = ?;
